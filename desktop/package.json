{
  "name": "agentsdr-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AgentSDR as a desktop app: the Next.js server, an embedded PostgreSQL and the scheduled jobs, all on this computer.",
  "license": "MIT",
  "main": "dist/main.js",
  "scripts": {
    "build:app": "cd .. && bun run build && bun desktop/scripts/stage-app.ts",
    "build:main": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build:main && electron .",
    "dist": "npm run build:app && npm run build:main && electron-builder",
    "dist:dir": "npm run build:app && npm run build:main && electron-builder --dir"
  },
  "dependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "^5"
  },
  "build": {
    "appId": "ai.agentsdr.desktop",
    "productName": "AgentSDR",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "build/icon.png",
      "build/tray.png",
      "build/tray@2x.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app",
        "to": "bundle"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "asar": false,
    "artifactName": "AgentSDR-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": null
  },
  "type": "module"
}
